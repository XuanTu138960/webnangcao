# =============================================
# Cookio - Biến môi trường (Environment Variables)
# Sao chép file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên Git!
# =============================================

# --- Bảo mật JWT ---
JWT_SECRET=your_super_secret_jwt_key_here_phenikaa_cookio_2026
JWT_EXPIRES_IN=7d

# --- Cơ sở dữ liệu SQLite ---
DB_PATH=./data/cookio.db

# --- Môi trường chạy ---
NODE_ENV=production

# --- Cổng backend ---
PORT=8080

# --- URL Frontend (dùng cho CORS) ---
FRONTEND_URL=http://localhost:3000
