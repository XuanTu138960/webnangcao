# Cấu hình ứng dụng
PORT=3001
NODE_ENV=development

# JWT Secret Key - thay đổi trong production
JWT_SECRET=cookio-super-secret-jwt-key-2024
JWT_EXPIRES_IN=7d

# Database SQLite
DB_PATH=./cookio.sqlite

# CORS - Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Admin mặc định
ADMIN_EMAIL=admin@cookio.vn
ADMIN_PASSWORD=Admin@123456
